#!groovy

// AWS I9g Graviton preview (SCT-1473): the latency-2.5tb-i8g-elasticity job on i9g.4xlarge.
// us-west-2b is the only AZ that had i9g capacity. Not in the triggers: preview instances go away at GA.
// Run one sub-test at a time (use_job_throttling): 3 parallel 9-node i9g clusters do not fit.
def lib = library identifier: 'sct@snapshot', retriever: legacySCM(scm)

perfRegressionParallelPipeline(
    backend: "aws",
    region: "us-west-2",
    availability_zone: "b",
    provision_type: 'on_demand',
    test_name: "performance_regression_test.PerformanceRegressionTest",
    test_config: """["configurations/performance/latency-decorator-error-thresholds-nemesis-ent-tablets.yaml", "test-cases/performance/perf-regression-latency-2.5tb-elasticity.yaml", "configurations/disable_kms.yaml", "configurations/arm_instance_types/i9g_4xlarge.yaml", "configurations/performance/i9g-elasticity.yaml"]""",
    sub_tests: ["test_latency_write_with_nemesis", "test_latency_read_with_nemesis", "test_latency_mixed_with_nemesis"],
)
